<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_tab_bar"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="@color/surface"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/tab_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tab_home_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/home"
            android:src="@drawable/ic_home"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tab_home_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_tasks"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tab_tasks_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/tasks"
            android:src="@drawable/ic_tasks"
            app:tint="@color/nav_inactive" />

        <TextView
            android:id="@+id/tab_tasks_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tasks"
            android:textColor="@color/nav_inactive"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_create"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_create_circle">

            <ImageView
                android:id="@+id/tab_create_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/create"
                android:src="@drawable/ic_add"
                app:tint="@android:color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/tab_create_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/create"
            android:textColor="@color/nav_inactive"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_stats"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tab_stats_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/stats"
            android:src="@drawable/ic_stats"
            app:tint="@color/nav_inactive" />

        <TextView
            android:id="@+id/tab_stats_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/stats"
            android:textColor="@color/nav_inactive"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
